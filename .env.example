# Copier en .env (à la racine ou dans backend/).
# L'API lit .env puis ../.env, docker compose lit celui de la racine.

# development / production / test
ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite en dev, Postgres en prod. Exemples :
#   sqlite+aiosqlite:///./braise.db
#   postgresql+asyncpg://braise:motdepasse@localhost:5432/braise  (postgres:// marche aussi)
DATABASE_URL=sqlite+aiosqlite:///./braise.db

# Clé pour signer les JWT. Obligatoire en prod, 32 caractères aléatoires minimum :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-with-a-long-random-string
ACCESS_TOKEN_MINUTES=1440

# Origines autorisées par le CORS (séparées par des virgules). En dev, c'est le serveur Vite.
FRONTEND_ORIGIN=http://localhost:5173
# URL publique du site, utilisée dans sitemap.xml et robots.txt
SITE_URL=http://localhost:5173

# Premier admin, créé au démarrage s'il n'y en a aucun.
# Sinon : python -m app.cli create-admin EMAIL
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Images : "local" (dossier MEDIA_ROOT servi sur MEDIA_URL) ou "s3"
STORAGE_BACKEND=local
MEDIA_ROOT=media
MEDIA_URL=/media
# taille max d'une image, en Mo
MAX_UPLOAD_MB=12

# Seulement si STORAGE_BACKEND=s3 (et pip install ".[s3]"). Marche aussi avec R2, Scaleway, MinIO.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique des fichiers (CDN). Vide = déduite du bucket.
S3_PUBLIC_URL=
S3_PREFIX=

# --- Docker ---
POSTGRES_PASSWORD=braise
# charge les recettes de démo au démarrage (pas de doublons si on relance)
SEED_ON_START=true
FRONT_PORT=8080

# --- Front (Vite) ---
# à remplir seulement si l'API est sur un autre domaine
VITE_API_URL=
# où le proxy de Vite envoie /api en dev
API_PROXY_TARGET=http://localhost:8000
